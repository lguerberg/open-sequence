{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": { "eq": "open-sequence.vercel.app" } }],
      "destination": "https://www.opensequence.dev/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path((?!llms\\.txt$|robots\\.txt$).*\\.txt)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
