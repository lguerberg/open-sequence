{
  "name": "@opensequence/engine",
  "version": "0.1.0",
  "description": "OpenSequence engine: entities, use cases and the Drizzle persistence of the seq schema.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@opensequence/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "zod": "^4.6.7",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
