{
  "name": "@opensequence/providers",
  "version": "0.1.0",
  "description": "OpenSequence provider adapters: smtp (any mailbox over SMTP and IMAP), allo (SMS + calls), attio (CRM), mock (dev and CI).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensequence/core": "workspace:*",
    "imapflow": "2.5.2",
    "mailparser": "3.9.40",
    "nodemailer": "10.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "msw": "^2.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
