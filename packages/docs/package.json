{
  "name": "@opensequence/docs",
  "version": "0.1.0",
  "description": "The OpenSequence documentation site (docs.opensequence.dev): Fumadocs, with the API reference and the reference pages generated from the code.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "pnpm run generate && next dev",
    "build": "pnpm run generate && next build && pnpm run redirects",
    "typecheck": "tsc --noEmit",
    "preview": "npx serve out",
    "redirects": "tsx scripts/redirects.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.4.2",
    "fumadocs-ui": "16.17.2",
    "lucide-react": "^1.50.0",
    "mermaid": "11.17.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
