{
  "name": "@opensequence/mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes OpenSequence to coding agents and LLM agents: sequences, contacts, enrollments, tasks and analytics, hosted over HTTP or run locally over stdio.",
  "license": "Apache-2.0",
  "homepage": "https://opensequence.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lguerberg/open-sequence",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opensequence-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@opensequence/sdk": "workspace:*",
    "@prefecthq/fastmcp-ts": "^1.7.3",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
