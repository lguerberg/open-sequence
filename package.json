{
  "name": "opensequence",
  "private": true,
  "version": "0.0.0",
  "description": "OpenSequence: a self-hosted service that runs multi-step outreach sequences for any CRM.",
  "license": "Apache-2.0",
  "homepage": "https://opensequence.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-sequence/opensequence"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @opensequence/engine run db:generate && pnpm --filter @opensequence/auth run db:generate",
    "dev": "pnpm --filter @opensequence/server run dev",
    "oseq": "pnpm --filter @opensequence/server run oseq"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
