# Postgres 14+. A transaction pooler is fine.
SEQ_DB_DSN=postgres://oseq:oseq@localhost:5432/opensequence

# postgres (default) | redis | memory
SEQ_QUEUE=postgres
# SEQ_REDIS_DSN=redis://localhost:6379

# Encryption keys for every stored secret: "id:base64key[,id:base64key...]", first is current.
# Generate with: pnpm oseq secrets new-key   (32 random bytes). Back it up with the database:
# without it the stored secrets are unreadable and must be re-entered.
SEQ_ENCRYPTION_KEYS=

# Operator token: creates projects and keys. Long and random.
SEQ_ADMIN_TOKEN=

# Base URL providers call back (webhooks, opt-out links).
SEQ_PUBLIC_URL=http://localhost:8080
SEQ_PORT=8080

# api | worker | all
SEQ_ROLES=all
SEQ_RUN_MIGRATIONS=1
SEQ_CONCURRENCY=8

# Platform-wide kill switches
# SEQ_DISABLED_CHANNELS=sms
# SEQ_PAUSED=1

# Development: every project uses the mock adapters. Refused when NODE_ENV=production.
SEQ_DEV_MOCK_PROVIDERS=1

SEQ_LOG_LEVEL=info
SEQ_METRICS=1
